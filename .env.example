# ==============================================================================
# FunDice Central Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js 22 / Express / Render)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# HS256 Secret key used for signing and verifying player JWT session tokens.
# REQUIRED when NODE_ENV=production.
# Recommended: generate a strong 32+ character hex string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_for_security

# MongoDB Atlas connection string for persistent player profiles, rolls, and match history
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fundice?appName=fundice-cluster

# ------------------------------------------------------------------------------
# Game Mechanics & Rules (Optional Overrides)
# ------------------------------------------------------------------------------
DICE_COUNT=5
ROLL_HISTORY=5
PEEKS_PER_GAME=3
PEEK_CAUGHT_CHANCE=0.3
INVITE_TTL_MS=60000
DISCONNECT_GRACE_MS=60000

# ------------------------------------------------------------------------------
# Flutter App Build Flags (Passed via --dart-define)
# ------------------------------------------------------------------------------
# Example: flutter run --dart-define=API_BASE_URL=https://your-app.onrender.com
# API_BASE_URL=https://fundice-backend.onrender.com
