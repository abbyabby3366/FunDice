{
  "name": "fundice-backend",
  "version": "1.0.0",
  "description": "FunDice game server: Express REST API and WebSocket push, in-memory state",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.js\"",
    "bot": "node scripts/bot.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
