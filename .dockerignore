# ==============================================================================
# FunDice Monorepo Root .dockerignore
# Excludes everything outside backend, preventing multi-gigabyte build contexts
# ==============================================================================

# Flutter & Mobile Client
android/
**/android/
ios/
**/ios/
lib/
**/lib/
assets/
**/assets/
build/
**/build/
.dart_tool/
**/.dart_tool/
.flutter-plugins*
.metadata
analysis_options.yaml
pubspec.yaml
pubspec.lock
fun_dice.iml

# Version Control & IDEs
.git/
**/.git/
.gitignore
.idea/
**/.idea/
.vscode/
**/.vscode/
.fallow/

# Documentation & Tools
docs/
tools/
test/
*.md

# Node & Backend Local Caches / Dev Files
node_modules/
**/node_modules/
backend/node_modules/
backend/**/node_modules/
backend/test/
backend/scripts/
backend/coverage/
backend/dist/

# Environment Variables & Secrets (Should be provided via runtime env, not in image)
.env
.env.*
backend/.env
backend/.env.*

# Logs & Temporary files
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
